# SECURE Environment Variables Template
# Copy to .env and populate with YOUR secrets

PORT=4000
NODE_ENV=production

# Supabase (get from your dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# Google OAuth2 (get from Google Cloud Console)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# IPFS Pinning (choose one)
PINATA_JWT=your_pinata_jwt_here
# OR
WEB3STORAGE_TOKEN=your_web3storage_token_here

# Livepeer (get from livepeer.studio)
LIVEPEER_API_KEY=your_livepeer_api_key

# Blockchain (for custom relayer)
RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
RELAYER_ADMIN_PRIVATE_KEY=your_private_key_here
NEXT_PUBLIC_CONTRACT_ADDRESS=your_contract_address

# Thirdweb (optional)
THIRDWEB_SECRET_KEY=your_thirdweb_secret
THIRDWEB_CLIENT_ID=your_thirdweb_client_id

# Admin API
ADMIN_API_KEY=your_secure_admin_key_here